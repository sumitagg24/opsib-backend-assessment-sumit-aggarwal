# OPSiB Backend Environment Configuration

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Frozen evaluation time (from fixture README)
# Do not change - this is the assessment requirement
FROZEN_EVALUATION_TIME=2026-10-16T15:00:00+05:30

# Database
DATABASE_URL=postgresql://opsib:opsib@localhost:5432/opsib

# Shift observation freshness window (hours)
# Workforce status observations older than this are considered stale
SHIFT_FRESHNESS_HOURS=2

# Reconciliation
RECONCILIATION_TOLERANCE_EA=0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
